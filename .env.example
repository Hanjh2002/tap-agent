# Copy this file to `.env` and enter the real key.

# ----------------GEMNINI-------------------
# Get a Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# UI language (default: en)
#   en | vi
# TAP_UI_LANGUAGE=en

# Optional: change the provider model (default: gemini-2.5-flash)
# TAP_MODEL=gemini-2.5-flash

# Optinal: model language (default: auto)
#   auto | en | vi | ja | ko
#   auto: the model responds in the language used by the user
#   en/vi/...: forces the model to respond in the target language
#              regardless of the language used by the user
# TAP_LANGUAGE=auto

# Optional: limit the number of loop iterations
# TAP_MAX_ITERATIONS=10

# Optional: model reasoning level (Gemini thinking)
#   off | low | medium | high | dynamic   (default: dynamic)
#   dynamic = the model decides how much to think based on the difficulty
#   off     = fully disabled; faster/cheaper but may perform poorly on complex tasks
# TAP_THINKING=dynamic


# ----------------OPENAI-------------------

# ----------------CLAUDE-------------------
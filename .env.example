# Copy file này thành `.env` và điền key thật.
# Lấy Gemini API key tại: https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# Optional: đổi model (mặc định: gemini-2.5-flash)
# TAP_MODEL=gemini-2.5-flash

# Optional: giới hạn số vòng loop
# TAP_MAX_ITERATIONS=10

# Optional: mức suy luận của model (Gemini thinking)
#   off | low | medium | high | dynamic   (mặc định: dynamic)
#   dynamic = model tự quyết nghĩ nhiều/ít theo độ khó
#   off     = tắt hẳn, nhanh/rẻ nhưng dễ làm ẩu với task phức tạp
# TAP_THINKING=dynamic